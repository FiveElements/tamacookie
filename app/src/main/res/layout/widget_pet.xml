<?xml version="1.0" encoding="utf-8"?>
<!-- Widget d'écran d'accueil (évolution 4c) : nom et humeur du résident, jauges, « Nourrir » et « Appeler ».
     Textes posés par PetWidget (WidgetTexts) ; RemoteViews : uniquement des vues autorisées. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF3A2E39"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF7A6B75"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_gauges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_g0_label"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_g0_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFF07893"
                android:progressBackgroundTint="#FFE8DCD3" />

            <TextView
                android:id="@+id/widget_g0_value"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF7A6B75"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_g1_label"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_g1_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFF07893"
                android:progressBackgroundTint="#FFE8DCD3" />

            <TextView
                android:id="@+id/widget_g1_value"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF7A6B75"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_g2_label"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_g2_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFF07893"
                android:progressBackgroundTint="#FFE8DCD3" />

            <TextView
                android:id="@+id/widget_g2_value"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF7A6B75"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_g3_label"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_g3_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFF07893"
                android:progressBackgroundTint="#FFE8DCD3" />

            <TextView
                android:id="@+id/widget_g3_value"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF7A6B75"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF7A6B75"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_feed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_feed"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_call"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
